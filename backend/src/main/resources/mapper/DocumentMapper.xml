<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rag.assistant.module.document.mapper.DocumentMapper">

    <resultMap id="BaseResultMap" type="com.rag.assistant.module.document.model.entity.Document">
        <id column="id" property="id"/>
        <result column="kb_id" property="kbId"/>
        <result column="user_id" property="userId"/>
        <result column="filename" property="filename"/>
        <result column="original_name" property="originalName"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="file_url" property="fileUrl"/>
        <result column="status" property="status"/>
        <result column="chunk_count" property="chunkCount"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, kb_id, user_id, filename, original_name, file_size, file_type,
        file_url, status, chunk_count, error_msg, is_deleted, created_at, updated_at
    </sql>

</mapper>
