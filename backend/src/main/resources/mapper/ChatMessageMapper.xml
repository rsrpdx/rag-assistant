<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rag.assistant.module.chat.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.rag.assistant.module.chat.model.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="sources" property="sources"/>
        <result column="tokens_used" property="tokensUsed"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, session_id, role, content, sources, tokens_used, is_deleted, created_at
    </sql>

</mapper>
