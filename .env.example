# ===================== LLM（OpenAI 兼容接口）=====================
# DeepSeek: https://api.deepseek.com/v1 ；本地 vLLM/Ollama 填内网地址
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_CHAT_MODEL=deepseek-chat

# ===================== MySQL（generate: openssl rand -base64 32）=====================
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_USER=rag_user
MYSQL_PASSWORD=your-db-password

# ===================== Redis =====================
REDIS_PASSWORD=your-redis-password

# ===================== MinIO =====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password

# ===================== JWT（generate: openssl rand -base64 64）=====================
JWT_SECRET=your-random-base64-key

# ===================== 对外端口 =====================
# 80 被占用或被运营商拦时可改成 8088 之类，然后访问 http://服务器IP:8088
HTTP_PORT=80